<Window x:Class="snakeGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:snakeGame"
        mc:Ignorable="d"
        Title="Змейка"
        Height="700"
        Width="880"
        MinHeight="700"
        MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Focusable="True"
        PreviewKeyDown="Window_KeyDown">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="620"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                BorderBrush="#333333"
                BorderThickness="2"
                Background="#F7F7F7"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">
            <Canvas x:Name="GameCanvas"
                    Width="600"
                    Height="600"
                    Background="#F7F7F7"/>
        </Border>

        <StackPanel Grid.Column="1" Margin="16,0,0,0">
            <TextBlock Text="Змейка" FontSize="26" FontWeight="Bold" Margin="0,0,0,12"/>

            <TextBlock Text="Счет:" FontWeight="Bold"/>
            <TextBlock x:Name="ScoreText" FontSize="22" Margin="0,0,0,10"/>

            <TextBlock Text="Рекорд режима:" FontWeight="Bold"/>
            <TextBlock x:Name="BestScoreText" FontSize="22" Margin="0,0,0,10"/>

            <TextBlock Text="Режим игры:"/>
            <ComboBox x:Name="ModeBox" Height="26" SelectedIndex="0" SelectionChanged="ModeBox_SelectionChanged" Margin="0,3,0,10">
                <ComboBoxItem Content="Классический"/>
                <ComboBoxItem Content="Усложненный"/>
            </ComboBox>

            <TextBlock Text="Размер поля:"/>
            <Grid Margin="0,3,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ColumnsBox" Grid.Column="0" Height="26" Text="20"/>
                <TextBox x:Name="RowsBox" Grid.Column="2" Height="26" Text="20"/>
            </Grid>

            <Button x:Name="StartButton"
                    Content="Новая игра"
                    Height="32"
                    Click="StartButton_Click"
                    Margin="0,0,0,8"/>

            <Button x:Name="PauseButton"
                    Content="Пауза"
                    Height="32"
                    Click="PauseButton_Click"
                    Margin="0,0,0,12"/>

            <TextBlock x:Name="StatusText"
                       TextWrapping="Wrap"
                       FontSize="14"
                       Foreground="#444444"/>
        </StackPanel>
    </Grid>
</Window>
